@inject WorkspaceStore Workspace
<select value="@Value" @onchange="Change" disabled="@Disabled" title="@Workspace.Assignee(Value)" aria-label="负责人">
<option value="">未指派</option>
@if (!string.IsNullOrEmpty(Value) && !Workspace.Users.Any(x => x.Id == Value)) { <option value="@Value">@Value</option> }
@foreach (var user in Workspace.Users) { <option value="@user.Id" disabled="@(user.Status != 1)">@Workspace.Assignee(user.Id)@(user.Status != 1 ? "（已停用）" : "")</option> }
</select>
@code {
    /// <summary>保留服务器返回的原始标识。</summary>
    [Parameter] public string? Value { get; set; }
    /// <summary>更新选择。</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    /// <summary>处理锁持有者之外禁用写入。</summary>
    [Parameter] public bool Disabled { get; set; }
    private Task Change(ChangeEventArgs e) => ValueChanged.InvokeAsync(string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value.ToString());
}
