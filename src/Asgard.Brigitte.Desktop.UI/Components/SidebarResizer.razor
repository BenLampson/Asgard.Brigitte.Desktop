@implements IAsyncDisposable
@inject IJSRuntime JS
<div @ref="_handle" class="sidebar-resizer" role="separator" tabindex="0"
     aria-label="@ClientText.T("调整项目栏宽度")" aria-orientation="vertical" aria-controls="project-sidebar"
     aria-valuemin="196" aria-valuemax="520" aria-valuenow="196"
     data-pixel-unit="@ClientText.T("像素")"
     title="@ClientText.T("拖动调整宽度，双击恢复默认；左右方向键可微调")"></div>
@code {
    private ElementReference _handle;
    private IJSObjectReference? _module, _controller;
    private bool _initializing, _disposed;

    /// <summary>挂载后绑定原生指针事件，拖动时只更新布局，不反复重绘整个看板。</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        _initializing = true;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Asgard.Brigitte.Desktop.UI/sidebar-resize.js");
            if (!_disposed) _controller = await _module.InvokeAsync<IJSObjectReference>("attach", _handle);
        }
        catch (JSDisconnectedException) when (_disposed) { /* 窗口关闭时不再初始化拖动。 */ }
        catch (TaskCanceledException) when (_disposed) { /* 窗口关闭可能取消尚未返回的模块加载。 */ }
        finally
        {
            _initializing = false;
            if (_disposed) await ReleaseAsync();
        }
    }

    /// <summary>退出工作区时注销监听；若正在初始化，由初始化收尾统一释放。</summary>
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (!_initializing) await ReleaseAsync();
    }

    /// <summary>清理指针捕获和尺寸监听，原生窗口已关闭时忽略断连。</summary>
    private async ValueTask ReleaseAsync()
    {
        try
        {
            if (_controller is not null)
            {
                await _controller.InvokeVoidAsync("dispose");
                await _controller.DisposeAsync();
                _controller = null;
            }
            if (_module is not null) { await _module.DisposeAsync(); _module = null; }
        }
        catch (JSDisconnectedException) { /* WebView 已销毁，无需再注销浏览器监听。 */ }
        catch (TaskCanceledException) { /* 关闭窗口时取消尚未完成的互操作。 */ }
    }
}
