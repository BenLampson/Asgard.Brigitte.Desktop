@implements IAsyncDisposable
@inject IJSRuntime JS
<dialog class="bug-move-dialog" @ref="_dialog" aria-labelledby="bug-move-heading">
<form @onsubmit="Save" @onsubmit:preventDefault="true">
<h2 id="bug-move-heading">@ClientText.T("移至{0}", BugDisplay.Statuses[Status])</h2>
<p class="ellipsis" title="@Title">@Title</p>
<small>@ClientText.T("请填写变更原因；部署和验收需注明环境、版本及结果。")</small>
@if (Status == "human_verified") { <div class="notice">@ClientText.T("仅在你已完成实际人工验收后确认；AI 自测不属于人工验收。")</div> }
<label>@ClientText.T("原因")<textarea autofocus required rows="6" aria-label="@ClientText.T("状态变更原因")" @bind="_reason" @bind:event="oninput"></textarea></label>
<div class="actions"><button type="button" disabled="@_saving" @onclick="Dismiss">@ClientText.T("取消")</button><button type="submit" class="primary" disabled="@(_saving || string.IsNullOrWhiteSpace(_reason))">@(Status == "human_verified" ? ClientText.T("我已人工验收通过") : ClientText.T("保存"))</button></div>
</form></dialog>
@code {
    [Parameter] public string? Title { get; set; }
    [Parameter, EditorRequired] public string Status { get; set; } = "";
    [Parameter] public EventCallback<string> Submit { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    private string _reason = "";
    private bool _saving, _disposed, _initializing;
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<BugMoveReason>? _receiver;

    /// <summary>原生模态框负责焦点陷阱；Escape 仅取消表单，不产生服务端写入。</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        _initializing = true;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Asgard.Brigitte.Desktop.UI/bug-card-drag.js");
            if (_disposed) return;
            _receiver = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("openReasonDialog", _dialog, _receiver);
        }
        catch (JSDisconnectedException) when (_disposed) { /* 窗口已关闭。 */ }
        catch (TaskCanceledException) when (_disposed) { /* 模块加载已取消。 */ }
        finally { _initializing = false; if (_disposed) await ReleaseAsync(); }
    }
    private async Task Save()
    {
        if (_saving || string.IsNullOrWhiteSpace(_reason)) return;
        _saving = true;
        await Submit.InvokeAsync(_reason.Trim());
    }
    [JSInvokable] public Task Dismiss() => _saving ? Task.CompletedTask : Cancel.InvokeAsync();
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (!_initializing) await ReleaseAsync();
    }
    private async ValueTask ReleaseAsync()
    {
        try { if (_module is not null) await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { /* 窗口已关闭。 */ }
        catch (TaskCanceledException) { /* 窗口关闭时取消互操作。 */ }
        finally { _receiver?.Dispose(); _receiver = null; _module = null; }
    }
}
