@implements IDisposable
<figure class="brigid-scene @(Forging || _playing ? "is-forging" : "")">
    <div class="brigid-orbit" aria-hidden="true"></div>
    <div class="brigid-art" aria-hidden="true">@Artwork</div>
    <div class="brigid-embers" aria-hidden="true"><i></i><i></i><i></i></div>
    <button type="button" class="brigid-play" aria-label="Brigid" aria-busy="@(Forging || _playing)" @onclick="PlayAsync"></button>
</figure>
@code {
    /// <summary>准备工作区时轻轻挥锤；动作不代表真实同步进度。</summary>
    [Parameter] public bool Forging { get; set; }
    // 点击只播放一个完整周期；加载中的循环不被点击重启。
    private bool _playing;
    private readonly CancellationTokenSource _lifetime = new();
    private async Task PlayAsync()
    {
        if (Forging || _playing) return;
        _playing = true;
        try { await Task.Delay(TimeSpan.FromSeconds(7.2), _lifetime.Token); }
        catch (OperationCanceledException) { }
        finally { _playing = false; }
    }
    // 关闭欢迎页时取消计时，避免保留已卸载的组件。
    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
    // 只载入随程序集发布的可信矢量，不接受用户或远程 SVG。
    private static readonly MarkupString Artwork = LoadArtwork();
    private static MarkupString LoadArtwork()
    {
        using var stream = typeof(BrigidScene).Assembly.GetManifestResourceStream("Asgard.Brigitte.Desktop.UI.Brigid.svg")!;
        using var reader = new StreamReader(stream);
        return new(reader.ReadToEnd());
    }
}
