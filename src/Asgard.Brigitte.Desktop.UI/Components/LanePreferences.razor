@implements IAsyncDisposable
@inject IClientHost Host
@inject SessionService Session
@inject WorkspaceStore Workspace
@inject BoardPreferenceStore Preferences
@inject Microsoft.Extensions.Options.IOptions<ClientOptions> Options
@inject IJSRuntime JS

<main class="preferences-window lane-preferences">
    <div class="lane-pref-back"><button class="link" @onclick="OnBack">← @ClientText.T("返回设置")</button><small>@ClientText.T("已保存在此设备")</small></div>
    <header class="preferences-header"><div><h1>@ClientText.T("看板泳道")</h1><p class="muted">@ClientText.T("按项目设置看板中状态泳道的显示顺序。")</p></div></header>
    <section class="preferences-section lane-pref-project">
        <div class="lane-pref-section-heading"><strong>@ClientText.T("配置项目")</strong><small>@ClientText.T("每个项目单独保存")</small></div>
        @if (!Session.HasWorkspace) { <p class="muted">@ClientText.T("请先打开本机工作区或登录在线工作区。")</p> }
        else if (Workspace.Projects.Count == 0) { <p class="muted">@ClientText.T("暂无可访问项目")</p> }
        else {
            <div class="lane-pref-chooser">
                <select aria-label="@ClientText.T("配置项目")" value="@_projectId" @onchange="SelectProject">
                    @foreach (var project in Workspace.Projects) { <option value="@project.Id">@project.Name</option> }
                </select>
                <button disabled="@(Workspace.Projects.Count < 2)" @onclick="OpenCopy">@ClientText.T("复制其他项目的配置")</button>
            </div>
        }
    </section>
    <section class="preferences-section lane-pref-section">
        <div class="lane-pref-section-heading"><div><strong>@ClientText.T("泳道顺序")</strong> <span class="lane-pref-count">@_order.Length</span></div><button disabled="@(_projectId.Length == 0)" @onclick="Reset">@ClientText.T("恢复默认")</button></div>
        <p class="notification-help muted">@ClientText.T("按住左侧拖拽柄上下排序，靠近窗口边缘可自动滚动。")</p>
        <div class="lane-pref-header"><span>@ClientText.T("拖动")</span><span>@ClientText.T("序号")</span><span>@ClientText.T("状态")</span></div>
        <div class="lane-pref-list" @ref="_list" data-project="@_projectId" aria-label="@ClientText.T("泳道顺序")">
            @for (var i = 0; i < _order.Length; i++) {
                var status = _order[i]; var position = i + 1;
                <div class="lane-pref-row" data-status="@status" @key="status">
                    <button type="button" class="lane-pref-grip" aria-label="@ClientText.T("调整泳道顺序：{0}。拖动或按 Alt＋上下方向键。", BugDisplay.Statuses[status])" title="@ClientText.T("拖动调整顺序；也可按 Alt＋↑／↓ 移动")">⋮⋮</button>
                    <span class="lane-pref-index">@position.ToString("00")</span><span class="status-dot @status"></span><span>@BugDisplay.Statuses[status]</span>
                    @if (status is "fixed" or "regressed") { <small class="lane-pref-history">@ClientText.T("历史状态")</small> }
                </div>
            }
        </div>
        <small class="muted">@ClientText.T("空的历史状态在看板中隐藏，设置中仍保留其顺序。")</small>
    </section>
    @if (_error.Length > 0) { <p class="error" role="alert">@_error</p> }
    <footer class="preferences-footer"><span class="muted">@ClientText.T("仅影响此设备当前账号的项目看板，不改变 BUG 状态。")</span><button @onclick="OnBack">@ClientText.T("返回设置")</button></footer>
    @if (_copyOpen) {
        <div class="lane-pref-overlay" @onclick="CloseCopy">
            <div class="lane-pref-dialog" role="dialog" aria-modal="true" aria-labelledby="lane-copy-title" @onclick:stopPropagation="true">
                <div class="lane-pref-section-heading"><h2 id="lane-copy-title">@ClientText.T("复制项目配置")</h2><button @onclick="CloseCopy" aria-label="@ClientText.T("关闭")">×</button></div>
                <p class="muted">@ClientText.T("选择一个项目，复制它在此设备上的泳道顺序。")</p>
                <label>@ClientText.T("应用到")<input readonly value="@Workspace.Projects.FirstOrDefault(project => project.Id == _projectId)?.Name" /></label>
                <label>@ClientText.T("从项目复制")<select @bind="_sourceId">@foreach (var project in OtherProjects) { <option value="@project.Id">@project.Name</option> }</select></label>
                <div class="lane-pref-copy-preview"><strong>@ClientText.T("来源顺序预览")</strong><ol>@foreach (var status in SourceOrder) { <li>@BugDisplay.Statuses[status]</li> }</ol></div>
                <p>@ClientText.T("复制后将替换目标项目当前顺序；来源项目不受影响。")</p>
                <div class="lane-pref-dialog-actions"><button @onclick="CloseCopy">@ClientText.T("取消")</button><button class="primary" disabled="@(_sourceId.Length == 0)" @onclick="Copy">@ClientText.T("复制并保存")</button></div>
            </div>
        </div>
    }
</main>

@code {
    /// <summary>回到普通设置。</summary>
    [Parameter] public EventCallback OnBack { get; set; }
    private string _projectId = "", _sourceId = "", _error = "";
    private string[] _order = [];
    private bool _copyOpen, _attached, _attaching, _disposed;
    private long _identity;
    private ElementReference _list;
    private DotNetObjectReference<LanePreferences>? _receiver;
    private IJSObjectReference? _module;
    private string Account => Session.IsLocal ? "local-workspace" : Options.Value.ApiBaseUrl.TrimEnd('/') + "\n" + Options.Value.TenantId + "\n" + Session.SubjectId;
    private IEnumerable<Project> OtherProjects => Workspace.Projects.Where(project => project.Id != _projectId);
    private IEnumerable<string> SourceOrder => _sourceId.Length == 0 ? [] : Preferences.Get(Account, _sourceId);

    protected override async Task OnInitializedAsync()
    {
        _identity = Session.IdentityVersion;
        if (!Session.HasWorkspace) return;
        try { await Workspace.LoadAsync(); _projectId = Workspace.Projects.FirstOrDefault()?.Id ?? ""; LoadOrder(); }
        catch (Exception ex) { _error = AppView.SafeError(ex); }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_attached || _attaching || _disposed) return;
        _attaching = true;
        try {
            _receiver = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Asgard.Brigitte.Desktop.UI/lane-preferences.js");
            if (_disposed) { await _module.DisposeAsync(); _module = null; }
            else { await _module.InvokeVoidAsync("attach", _list, _receiver); _attached = true; }
        } catch (JSDisconnectedException) when (_disposed) { }
        catch (TaskCanceledException) when (_disposed) { }
        finally { _attaching = false; }
    }
    private void LoadOrder() => _order = _projectId.Length == 0 ? [] : Preferences.Get(Account, _projectId);
    private void SelectProject(ChangeEventArgs e) { _projectId = e.Value?.ToString() ?? ""; _copyOpen = false; _error = ""; LoadOrder(); }
    private void OpenCopy() { _sourceId = OtherProjects.FirstOrDefault()?.Id ?? ""; _copyOpen = _sourceId.Length > 0; }
    private void CloseCopy() => _copyOpen = false;
    private void Reset() => Save(BugDisplay.BoardStatuses);
    private void Copy() { if (OtherProjects.Any(project => project.Id == _sourceId)) { Save(Preferences.Get(Account, _sourceId)); if (_error.Length == 0) _copyOpen = false; } }
    private void Save(IEnumerable<string> order)
    {
        if (_projectId.Length == 0 || _identity != Session.IdentityVersion || !Session.HasWorkspace) return;
        try { Preferences.Set(Account, _projectId, order); LoadOrder(); _error = ""; Host.PublishChange(); }
        catch (Exception ex) { _error = AppView.SafeError(ex); }
    }
    /// <summary>拖拽跨项目或无效状态时不写入，顺序仅在保存成功后更新。</summary>
    [JSInvokable]
    public Task MoveLane(string projectId, string source, string target, bool after)
    {
        if (projectId != _projectId || source == target || !_order.Contains(source) || !_order.Contains(target)) return Task.CompletedTask;
        var next = _order.ToList(); next.Remove(source); next.Insert(next.IndexOf(target) + (after ? 1 : 0), source);
        if (!next.SequenceEqual(_order)) { Save(next); StateHasChanged(); }
        return Task.CompletedTask;
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { if (_module is not null) { await _module.InvokeVoidAsync("detach", _list); await _module.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        finally { _receiver?.Dispose(); }
    }
}
