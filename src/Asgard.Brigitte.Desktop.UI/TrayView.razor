@implements IDisposable
@inject WorkspaceStore Workspace
@inject SessionService Session
@inject IClientHost Host
<div class="tray-panel @(!Session.IsAuthenticated ? "tray-signed-out" : null)">
<header><Brand /><strong>Brigitte</strong><span class="tray-session-status">@(Session.IsAuthenticated ? ClientText.T("项目概览") : ClientText.T("未登录"))</span></header>
@if (!Session.IsAuthenticated)
{
    <p class="tray-login-hint">@ClientText.T("登录后查看项目与 BUG")</p>
    <div class="tray-login-actions">
        <button class="primary" @onclick="() => Host.OpenAsync(new(DesktopViewKind.Main))"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" /></svg>@ClientText.T("登录")</button>
        <button @onclick="Host.Quit"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>@ClientText.T("退出")</button>
    </div>
}
else
{
<div class="tray-projects">
<div class="tray-labels"><span>@ClientText.T("项目")</span><span title="@ClientText.T("不含已处理、已回归及已结束的 BUG")">@ClientText.T("未解决")</span><span title="@ClientText.T("未解决中的紧急和高优先级 BUG")">@ClientText.T("高优先级")</span></div>
@foreach(var p in Workspace.Projects)
{
    var unresolved = Workspace.Stats(p.Id)?.Unresolved ?? 0;
    var highPriority = Workspace.Stats(p.Id)?.UnresolvedHighPriority ?? 0;
    <button class="tray-project" title="@p.Name" aria-label="@ClientText.T("{0}，未解决 {1}，其中高优先级 {2}", p.Name, unresolved, highPriority)" @onclick="() => Host.OpenAsync(new(DesktopViewKind.Main,ProjectId:p.Id))">
        <span class="ellipsis">@p.Name</span><span class="tray-count @(unresolved == 0 ? "is-zero" : null)">@unresolved</span><span class="tray-count @(highPriority == 0 ? "is-zero" : "is-priority")">@highPriority</span>
    </button>
}
@if(Workspace.Projects.Count == 0) { <p class="tray-empty">@(Host.SyncReady ? ClientText.T("暂无可访问项目") : ClientText.T("正在同步项目…"))</p> }
</div>
@if(Host.RecentChanges.Count>0) {
<section class="tray-updates"><div class="heading"><strong>@ClientText.T("未读动态") <span class="unread-count">@Host.UnreadChanges</span></strong><button class="link" @onclick="Host.MarkChangesRead">@ClientText.T("全部已读")</button></div>
<div class="tray-update-list">
@foreach(var notice in Host.RecentChanges) {
    <div class="tray-update" @key="notice.Id">
        <p>@notice.DisplayMessage</p>
        <div class="tray-update-actions"><small>@notice.Time.ToLocalTime().ToString("MM-dd HH:mm")</small><button class="link" aria-label="@ClientText.T("标为已读并移除这条动态")" @onclick="() => Host.MarkChangeRead(notice.Id)">@ClientText.T("已读")</button></div>
    </div>
}
</div>
</section>
}
<footer><button class="primary tray-open" @onclick="() => Host.OpenAsync(new(DesktopViewKind.Main))">@ClientText.T("打开工作区") <span aria-hidden="true">↗</span></button><button class="tray-quit" @onclick="Host.Quit">@ClientText.T("退出")</button></footer>
}
</div>
@code {
    protected override void OnInitialized() { Host.Changed+=Changed; Host.StatusChanged+=Changed; Workspace.Changed+=Changed; }
    private void Changed()=>_=InvokeAsync(StateHasChanged);
    public void Dispose() { Host.Changed-=Changed; Host.StatusChanged-=Changed; Workspace.Changed-=Changed; }
}
