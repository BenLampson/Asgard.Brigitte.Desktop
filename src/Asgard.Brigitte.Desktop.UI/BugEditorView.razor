@implements IDisposable
@inject BrigitteApi Api
@inject WorkspaceStore Workspace
@inject IClientHost Host
@if (_loading) { <div class="center">@ClientText.T("正在读取…")</div> } else {
<div class="editor-window">
<header class="heading"><h1>@(View.Kind==DesktopViewKind.Create ? ClientText.T("提交 BUG") : ClientText.T("编辑 BUG"))</h1><div class="spacer"></div><button @onclick="Cancel">@ClientText.T("取消")</button><button class="primary" disabled="@(_saving || !_canWrite || !Host.CanWrite)" @onclick="Save">@(_createdId is null ? View.Kind==DesktopViewKind.Create ? ClientText.T("提交 BUG") : ClientText.T("保存修改") : ClientText.T("重试剩余附件"))</button></header>
@if (_error!="") { <div class="notice error" role="alert">@_error</div> }
<div class="editor-layout">
<section><label>@ClientText.T("标题 *")<input @bind="_input.Title" disabled="@(!_canWrite || _createdId is not null)" /></label>
<label>@ClientText.T("问题描述 *")<MarkdownEditor @bind-Value="_input.Description" Rows="3" Label="@ClientText.T("问题描述")" Disabled="@(!_canWrite || _createdId is not null)" /></label>
<label>@ClientText.T("问题内容 *")<MarkdownEditor @bind-Value="_input.Content" Rows="15" Label="@ClientText.T("问题内容")" Disabled="@(!_canWrite || _createdId is not null)" /></label>
<div class="upload-zone" @ondragover:preventDefault="true"><InputFile OnChange="PickFromBrowser" multiple disabled="@(!_canWrite)" /><span>@ClientText.T("可添加多个附件，也可拖放或粘贴图片")</span></div>
<div class="paste-zone" contenteditable="true" data-paste-upload data-paste-placeholder="@ClientText.T("在此粘贴图片或文件")" @ref="_paste" aria-label="@ClientText.T("粘贴附件")" @onfocus="PreparePaste">@ClientText.T("在此粘贴图片或文件")</div>
@foreach(var f in _files) { <div class="attachment"><span>@f.FileName</span><small>@((f.Bytes.Length/1024d).ToString("0.0")) KB</small><button @onclick="() => _files.Remove(f)" disabled="@_saving">@ClientText.T("移除")</button></div> }
</section><aside><h3>@ClientText.T("BUG 属性")</h3><label>@ClientText.T("项目")<input value="@Workspace.Projects.FirstOrDefault(p=>p.Id==_input.ProjectId)?.Name" disabled /></label>
<label>@ClientText.T("优先级")<select @bind="_input.Priority" disabled="@(!_canWrite || _createdId is not null)">@foreach(var p in BugDisplay.Priorities) { <option value="@p.Key">@p.Value</option> }</select></label>
<label>@ClientText.T("负责人")<AssigneeSelect @bind-Value="_input.AssigneeId" Disabled="@(!_canWrite || _createdId is not null)" /></label>
<label>@ClientText.T("涉及服务 / 组件")<input @bind="_services" placeholder="@ClientText.T("使用逗号分隔，也可输入自定义服务名")" disabled="@(!_canWrite || _createdId is not null)" /></label>
<label>@ClientText.T("部署 / 变更说明")<MarkdownEditor @bind-Value="_input.DeploymentNotes" Rows="5" Label="@ClientText.T("部署 / 变更说明")" Disabled="@(!_canWrite || _createdId is not null)" /></label>
@if(View.Kind==DesktopViewKind.Create) { <label>@ClientText.T("来源")<input @bind="_input.Source" disabled="@(_createdId is not null)" /></label> }
@if(!_canWrite) { <p class="warning">@ClientText.T("此 BUG 已由其他 Worker 领取，请关闭编辑窗口并刷新详情。")</p> }
</aside></div></div>
}
@code {
    /// <summary>新增和编辑均由原生独立窗口承载。</summary>
    [Parameter] public DesktopView View { get; set; }=null!;
    [Inject] public IJSRuntime JS { get; set; }=null!;
    private BugInput _input=new(){Priority="medium",Source="web"};
    private List<PickedFile> _files=[];
    private string _services="",_error="";
    private string? _createdId;
    private bool _loading=true,_saving,_canWrite=true,_pasteReady;
    private ElementReference _paste;
    private DotNetObjectReference<BugEditorView>? _reference;
    protected override async Task OnInitializedAsync() {
        try {
            _input.ProjectId=View.ProjectId??"";
            if(View.Kind==DesktopViewKind.Edit) {
                var b=(await Api.DetailAsync(View.Id!)).Bug;
                _input=new(){ProjectId=b.ProjectId,Title=b.Title,Description=b.Description,Content=b.Content,Priority=b.Priority,AssigneeId=b.AssigneeId,AffectedServices=b.AffectedServices,DeploymentNotes=b.DeploymentNotes,Source=b.Source};
                _services=string.Join(", ",b.AffectedServices); _canWrite=BugDisplay.CanWrite(b,Host.WorkerId);
                _input.WorkerId=BugDisplay.HasLock(b) ? Host.WorkerId : null;
            }
        } catch(Exception ex) { _error=AppView.SafeError(ex); _canWrite=false; } finally { _loading=false; }
    }
    private async Task Save() {
        if(_saving || !_canWrite) return;
        _error="";
        if(string.IsNullOrWhiteSpace(_input.Title)||string.IsNullOrWhiteSpace(_input.Description)||string.IsNullOrWhiteSpace(_input.Content)) { _error=ClientText.T("请填写标题、问题描述和问题内容。"); return; }
        _saving=true;
        try {
            _input.AffectedServices=_services.Split([',','，','\n'],StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);
            if(View.Kind==DesktopViewKind.Edit || _createdId is not null) {
                var current=(await Api.DetailAsync(_createdId??View.Id!)).Bug;
                if(!BugDisplay.CanWrite(current,Host.WorkerId)) throw new InvalidOperationException(ClientText.T("其他 Worker 已领取此 BUG，刷新详情后再操作。"));
                _input.WorkerId=BugDisplay.HasLock(current)?Host.WorkerId:null;
            }
            if(_createdId is null) {
                var saved=View.Kind==DesktopViewKind.Create ? await Api.CreateBugAsync(_input) : await Api.UpdateBugAsync(View.Id!,_input);
                _createdId=saved.Id; Host.PublishChange();
            }
            foreach(var f in _files.ToArray()) {
                await Api.UploadAsync(_createdId,f.FileName,f.ContentType,f.Bytes,_input.WorkerId); _files.Remove(f);
            }
            Host.PublishChange(); Host.Close(View);
        } catch(Exception ex) { _error=(_createdId is null?"":ClientText.T("BUG 已保存，附件尚未全部上传。"))+AppView.SafeError(ex); } finally { _saving=false; }
    }
    private async Task Cancel() { if(await Host.ConfirmAsync(ClientText.T("关闭编辑窗口？"),ClientText.T("未保存的修改将丢失。"))) Host.Close(View); }
    private async Task PickFromBrowser(InputFileChangeEventArgs e) {
        try { foreach(var file in e.GetMultipleFiles(100)) { using var memory=new MemoryStream(); await file.OpenReadStream(50*1024*1024).CopyToAsync(memory); _files.Add(new(file.Name,file.ContentType,memory.ToArray())); } } catch(Exception ex) { _error=ex.Message; }
    }
    private async Task PreparePaste() { if(_pasteReady) return; _reference=DotNetObjectReference.Create(this); await JS.InvokeVoidAsync("brigitte.attachPaste",_paste,_reference); _pasteReady=true; }
    /// <summary>只接收用户主动粘贴的附件，文件内容不在编辑器执行。</summary>
    [JSInvokable] public Task Pasted(string name,string type,string base64) {
        if(!_canWrite || _saving || base64.Length>70*1024*1024) return Task.CompletedTask;
        var bytes=Convert.FromBase64String(base64);if(bytes.Length>50*1024*1024)return Task.CompletedTask;
        _files.Add(new(Path.GetFileName(name),type,bytes)); return InvokeAsync(StateHasChanged);
    }
    public void Dispose() => _reference?.Dispose();
}
