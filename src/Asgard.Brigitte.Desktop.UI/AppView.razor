@implements IDisposable
@inject SessionService Session
@inject IClientHost Host
@inject WorkspaceStore Workspace
@inject BrigitteApi Api
@inject Microsoft.Extensions.Options.IOptions<ClientOptions> Options
<CascadingValue Value="View" Name="OwnerView">
<CascadingValue Value="Host.Language" Name="DesktopLanguage">
<div lang="@(Host.Language == "zh-CN" ? "zh-CN" : "en")" class="client @Host.Theme @(View.Kind == DesktopViewKind.Tray ? "tray-client" : null)">
@if (View.Kind == DesktopViewKind.Settings) { <SettingsView /> }
else if (View.Kind == DesktopViewKind.About) { <AboutView /> }
else if (View.Kind == DesktopViewKind.Privacy) { <PrivacyView /> }
else if (!_ready) { <WelcomeView Verifying="true" /> }
else if (View.Kind==DesktopViewKind.Tray && !Session.HasWorkspace) { <TrayView /> }
else if (!Session.HasWorkspace) {
    <WelcomeView Busy="_busy" Restoring="_restoring" RestorePending="Session.RestorePending" Error="@_error" Login="Login" Restore="Restore" Local="UseLocal" />
} else if (!Session.IsLocal && !Host.SyncReady) {
    <SyncStartupView />
} else {
    @if (Host.PendingCommands>0) { <div class="sync-status" role="status">@ClientText.T("线上已保存，等待同步… 完成后会自动更新，请勿重复提交。")</div> }
    else if (!Host.CanWrite) { <div class="sync-status" role="status">@ClientText.T("连接已中断，正在重连。当前内容只读。")</div> }
    @if(Session.PersistenceWarning!="") { <div class="notice warning" role="alert">@Session.PersistenceWarning</div> }
    @if (!string.IsNullOrEmpty(_error)) { <div class="notice error" role="alert">@_error</div> }
    @switch (View.Kind) {
        case DesktopViewKind.Main: <WorkspaceView View="View" /> break;
        case DesktopViewKind.Tray: <TrayView /> break;
        case DesktopViewKind.Detail: <BugDetailView View="View" /> break;
        case DesktopViewKind.Create:
        case DesktopViewKind.Edit: <BugEditorView View="View" /> break;
        case DesktopViewKind.Status:
        case DesktopViewKind.Comment: <BugActionView View="View" /> break;
        case DesktopViewKind.ProjectInvitations:
        case DesktopViewKind.JoinProject: <ProjectInvitationView View="View" /> break;
        default: <ManagementView View="View" /> break;
    }
    @if (Host.ShowNotification(View)) {
        <aside class="sync-toast" role="status" aria-live="polite"><span class="sync-toast-icon">✓</span><div><strong>@ClientText.T("工作区动态")</strong><p>@Host.NotificationText</p></div><button aria-label="@ClientText.T("关闭提示")" @onclick="Host.DismissNotification">×</button></aside>
    }
}
</div>
</CascadingValue>
</CascadingValue>
@code {
    /// <summary>每个原生窗口独立提供的导航上下文。</summary>
    [Parameter] public DesktopView View { get; set; } = new(DesktopViewKind.Main);
    private bool _ready, _busy, _restoring;
    private string _error = "";
    /// <summary>每次启动显示使用入口；选择在线服务后才恢复凭据，离线启动不等待网络。</summary>
    protected override void OnInitialized()
    {
        Session.Changed += Changed; Host.Changed += Changed; Host.StatusChanged += Changed;
        _ready = true;
    }
    /// <summary>数据库打开失败留在欢迎页，不清空本机记录。</summary>
    private async Task UseLocal()
    {
        _busy = true; _error = "";
        try { Api.OpenLocalWorkspace(); await Session.UseLocalAsync(); }
        catch (Exception ex) { _error = SafeError(ex); }
        finally { _busy = false; }
    }
    private async Task Login()
    {
        _busy = true; _error = "";
        try {
            await Session.InitializeAsync();
            if (!Session.IsAuthenticated && !Session.RestorePending) await Session.LoginAsync();
        }
        catch (OperationCanceledException) { _error = ClientText.T("登录已取消或超时，可重新登录。"); }
        catch (Exception ex) { _error = SafeError(ex); }
        finally { _busy = false; }
    }
    /// <summary>手动恢复已保存的会话，不触发新的浏览器登录。</summary>
    private async Task Restore()
    {
        _busy = true; _restoring = true; _error = "";
        try { await Session.InitializeAsync(); }
        catch (Exception ex) { _error = SafeError(ex); }
        finally { _busy = false; _restoring = false; }
    }
    private void Changed()
    {
        if (!Session.HasWorkspace) Workspace.Clear();
        _ = InvokeAsync(() => { if (Session.HasWorkspace) _error = ""; StateHasChanged(); });
    }
    /// <summary>协议异常只显示安全分类，不输出回调或令牌。</summary>
    public static string SafeError(Exception ex) => ex is Asgard.Heimdall.Client.HeimdallClientException sdk ? ClientText.T("登录服务返回：") + sdk.Category : ex.Message;
    public void Dispose() { Session.Changed -= Changed; Host.Changed -= Changed; Host.StatusChanged -= Changed; }
}
