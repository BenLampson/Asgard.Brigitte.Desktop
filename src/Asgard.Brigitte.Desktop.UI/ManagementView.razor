@implements IDisposable
@inject WorkspaceStore Workspace
@inject BrigitteApi Api
@inject IClientHost Host
@inject Microsoft.Extensions.Options.IOptions<ClientOptions> Options
<main class="management @(View.Kind is DesktopViewKind.ProjectCreate or DesktopViewKind.ProjectEdit ? "project-form-window" : "")">
<header class="window-heading"><Brand /><h1>@Title</h1><div class="spacer"></div>
@if(View.Kind==DesktopViewKind.Projects) { <button class="primary" @onclick="() => Host.OpenAsync(new(DesktopViewKind.ProjectCreate), View)">＋ 创建项目</button><button @onclick="() => Host.OpenAsync(new(DesktopViewKind.JoinProject), View)">通过邀请加入</button> }
@if(View.Kind==DesktopViewKind.Keys) { <button class="primary" @onclick="() => Host.OpenAsync(new(DesktopViewKind.KeyCreate), View)">＋ 创建 Key</button> }
@if(View.Kind==DesktopViewKind.Users && Workspace.Access.IsTenantAdmin) { <button @onclick="ManageUsers">在 Heimdall 管理用户 ↗</button> }
</header>
@if(_error!="") { <div class="notice error" role="alert">@_error</div> }
@if(_busy) { <div class="notice" role="status">正在处理…</div> }
<div class="management-body">
@switch(View.Kind) {
case DesktopViewKind.Projects:
<div class="project-grid">@foreach(var p in Workspace.Projects) { <section class="project-card"><h2 title="@p.Name">@p.Name</h2><p class="muted">@p.Code · @(p.Status=="active"?"正常":"已归档")</p><p>@p.Description</p><p>BUG @Workspace.Stats(p.Id)?.Total · 负责人 <span title="@p.OwnerId">@Workspace.Assignee(p.OwnerId)</span></p><div class="actions"><button @onclick="() => Host.OpenAsync(new(DesktopViewKind.Main,ProjectId:p.Id), View)">打开 BUG 看板</button><button @onclick="() => Host.OpenAsync(new(DesktopViewKind.Project,p.Id,p.Id), View)">项目详情</button>@if(CanManage(p)) { <button @onclick="() => Host.OpenAsync(new(DesktopViewKind.ProjectEdit,p.Id,p.Id), View)">编辑</button><button @onclick="() => Host.OpenAsync(new(DesktopViewKind.ProjectInvitations,p.Id,p.Id), View)">邀请成员</button> }</div></section> }</div>
break;
case DesktopViewKind.Project:
@if(_project is not null) { <div class="project-overview"><h2>@_project.Name</h2><p>@_project.Description</p><dl><dt>项目 ID</dt><dd><code>@_project.Id</code> <button @onclick="() => Host.CopyAsync(_project.Id)">⧉ 复制</button></dd><dt>项目编码</dt><dd>@_project.Code</dd><dt>状态</dt><dd>@(_project.Status=="active"?"正常":"已归档")</dd><dt>负责人</dt><dd title="@_project.OwnerId">@Workspace.Assignee(_project.OwnerId)</dd><dt>项目成员</dt><dd>@foreach(var id in _project.MemberUserIds) { <div title="@id">@Workspace.Assignee(id)</div> }</dd></dl><h2>BUG 状态分布</h2><div class="stat-grid">@foreach(var s in BugDisplay.Statuses) { <div><span>@s.Value</span><strong>@_projectBugs.Count(b=>b.Status==s.Key)</strong></div> }</div><div class="actions"><button class="primary" @onclick="() => Host.OpenAsync(new(DesktopViewKind.Main,ProjectId:_project.Id), View)">打开 BUG 看板</button><button @onclick="BatchPrompt">⧉ 复制批量修复提示词</button>@if(CanManage(_project)) { <button @onclick="() => Host.OpenAsync(new(DesktopViewKind.ProjectEdit,_project.Id,_project.Id), View)">编辑项目</button><button @onclick="() => Host.OpenAsync(new(DesktopViewKind.ProjectInvitations,_project.Id,_project.Id), View)">邀请成员</button> }</div></div> }
break;
case DesktopViewKind.ProjectCreate:
case DesktopViewKind.ProjectEdit:
@if(View.Kind==DesktopViewKind.ProjectEdit && !CanManage(_project)) { <p>仅项目负责人可管理此项目。</p> } else {
<div class="form"><label>项目名称<input maxlength="100" @bind="_input.Name" /></label><label>项目编码（选填）<input maxlength="50" placeholder="留空自动生成" @bind="_input.Code" /></label><label>描述（选填）<textarea rows="3" @bind="_input.Description"></textarea></label>@if(Workspace.Access.IsTenantAdmin) { <label>负责人<AssigneeSelect @bind-Value="_input.OwnerId" /></label> } else { <p class="muted">你是项目负责人，可修改项目名称，并通过邀请链接添加成员。</p> }@if(View.Kind==DesktopViewKind.ProjectEdit) { <label>状态<select @bind="_input.Status"><option value="active">正常</option><option value="archived">已归档</option></select></label> }@if(Workspace.Access.IsTenantAdmin || View.Kind==DesktopViewKind.ProjectEdit) { <fieldset><legend>项目成员</legend>@foreach(var user in Workspace.Users.Where(u=>Workspace.Access.IsTenantAdmin || _project?.MemberUserIds.Contains(u.Id)==true)) { <label class="check-row" title="@user.Id"><input type="checkbox" checked="@_members.Contains(user.Id)" disabled="@(user.Id == _project?.OwnerId)" @onchange="e=>Member(user.Id,e.Value is true)" />@Workspace.Assignee(user.Id)</label> }@foreach(var id in _members.Where(id=>!Workspace.Users.Any(u=>u.Id==id)).ToArray()) { <label class="check-row" title="@id"><input type="checkbox" checked @onchange="e=>Member(id,e.Value is true)" />@id</label> }</fieldset> }<div class="actions"><button @onclick="Close">取消</button><button class="primary" disabled="@(_busy || !Host.CanWrite)" @onclick="SaveProject">保存项目</button></div></div> }
break;
case DesktopViewKind.Keys:
<p class="notice">个人 AI 接入凭据。明文 Key 仅在创建成功后显示一次。</p><table><thead><tr><th>名称</th><th>Key 前缀</th><th>权限范围</th><th>状态</th><th>创建时间</th><th></th></tr></thead><tbody>@foreach(var key in _keys) { <tr><td>@key.Name</td><td><code>@key.KeyPrefix</code></td><td>@string.Join("、",key.Scopes)</td><td>@(key.Enabled?"启用":"停用")</td><td>@key.CreateTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td><button class="danger" disabled="@(_busy || !Host.CanWrite)" @onclick="()=>Revoke(key)">撤销</button></td></tr> }</tbody></table>@if(_keys.Count==0) { <p class="center">暂无 MCP Key</p> }
break;
case DesktopViewKind.KeyCreate:
<div class="form"><label>名称<input maxlength="100" @bind="_keyName" /></label><fieldset><legend>权限范围</legend>@foreach(var scope in new[]{"bug:read","bug:write","bug:delete","bug:admin"}) { <label class="check-row"><input type="checkbox" checked="@_scopes.Contains(scope)" @onchange="e=>Scope(scope,e.Value is true)" />@scope</label> }</fieldset><div class="actions"><button @onclick="Close">取消</button><button class="primary" disabled="@(_busy || !Host.CanWrite)" @onclick="CreateKey">创建</button></div></div>
break;
case DesktopViewKind.KeyResult:
@if(_result is not null) { <div class="form"><p class="notice">请立即保存。关闭此窗口后无法再次查看明文 Key。</p><label>名称<input readonly value="@_result.Name" /></label><label>明文 Key<textarea readonly rows="3" value="@_result.PlainKey"></textarea></label><div class="actions"><button @onclick="()=>Host.CopyAsync(_result.PlainKey)">⧉ 复制 Key</button><button class="primary" @onclick="()=>Host.CopyAsync(_setupPrompt)">⧉ 复制 MCP 接入提示词</button></div><pre class="setup-prompt">@_setupPrompt</pre><button @onclick="Close">我已保存，关闭</button></div> } else { <p>此明文 Key 已消费，请查看原结果窗口。</p> }
break;
case DesktopViewKind.Users:
@if(!Workspace.Access.IsTenantAdmin) { <p>仅租户管理员可访问用户目录。</p> } else { <p class="notice">用户身份由 Heimdall 维护。</p><table><thead><tr><th>显示名称</th><th>用户名</th><th>用户 ID</th><th>状态</th></tr></thead><tbody>@foreach(var user in Workspace.Users.Skip((_page-1)*20).Take(20)) { <tr><td>@user.DisplayName</td><td>@user.Username</td><td><code>@user.Id</code></td><td>@(user.Status==1?"启用":"停用")</td></tr> }</tbody></table><div class="pagination"><button disabled="@(_page<=1)" @onclick="()=>_page--">‹</button><span>@_page</span><button disabled="@(_page*20>=Workspace.Users.Count)" @onclick="()=>_page++">›</button></div> }
break;
case DesktopViewKind.Image:
@if(_image is not null) { <img class="attachment-preview" alt="@_image.FileName" src="@ImageSource" /> }
break;
}
</div></main>
