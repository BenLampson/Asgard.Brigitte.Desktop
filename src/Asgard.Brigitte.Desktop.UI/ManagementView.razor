@implements IDisposable
@inject WorkspaceStore Workspace
@inject BrigitteApi Api
@inject IClientHost Host
@inject Microsoft.Extensions.Options.IOptions<ClientOptions> Options
<main class="management @(View.Kind is DesktopViewKind.ProjectCreate or DesktopViewKind.ProjectEdit ? "project-form-window" : "")">
<header class="window-heading"><Brand /><h1>@Title</h1><div class="spacer"></div>
@if(View.Kind==DesktopViewKind.Projects) { <button class="primary" @onclick="() => Host.OpenAsync(new(DesktopViewKind.ProjectCreate), View)">@ClientText.T("＋ 创建项目")</button><button @onclick="() => Host.OpenAsync(new(DesktopViewKind.JoinProject), View)">@ClientText.T("通过邀请加入")</button> }
@if(View.Kind==DesktopViewKind.Keys) { <button class="primary" @onclick="() => Host.OpenAsync(new(DesktopViewKind.KeyCreate), View)">@ClientText.T("＋ 创建 Key")</button> }
@if(View.Kind==DesktopViewKind.Users && Workspace.Access.IsTenantAdmin) { <button @onclick="ManageUsers">@ClientText.T("在 Heimdall 管理用户 ↗")</button> }
</header>
@if(_error!="") { <div class="notice error" role="alert">@_error</div> }
@if(_busy) { <div class="notice" role="status">@ClientText.T("正在处理…")</div> }
<div class="management-body">
@switch(View.Kind) {
case DesktopViewKind.Projects:
<div class="project-grid">@foreach(var p in Workspace.Projects) { <section class="project-card"><h2 title="@p.Name">@p.Name</h2><p class="muted">@p.Code · @(p.Status=="active"?ClientText.T("正常"):ClientText.T("已归档"))</p><p>@p.Description</p><p>@ClientText.T("BUG {0} · 负责人", Workspace.Stats(p.Id)?.Total) <span title="@p.OwnerId">@Workspace.Assignee(p.OwnerId)</span></p><div class="actions"><button @onclick="() => Host.OpenAsync(new(DesktopViewKind.Main,ProjectId:p.Id), View)">@ClientText.T("打开 BUG 看板")</button><button @onclick="() => Host.OpenAsync(new(DesktopViewKind.Project,p.Id,p.Id), View)">@ClientText.T("项目详情")</button>@if(CanManage(p)) { <button @onclick="() => Host.OpenAsync(new(DesktopViewKind.ProjectEdit,p.Id,p.Id), View)">@ClientText.T("编辑")</button><button @onclick="() => Host.OpenAsync(new(DesktopViewKind.ProjectInvitations,p.Id,p.Id), View)">@ClientText.T("邀请成员")</button> }</div></section> }</div>
break;
case DesktopViewKind.Project:
@if(_project is not null) { <div class="project-overview"><h2>@_project.Name</h2><p>@_project.Description</p><dl><dt>@ClientText.T("项目 ID")</dt><dd><code>@_project.Id</code> <button @onclick="() => Host.CopyAsync(_project.Id)">@ClientText.T("⧉ 复制")</button></dd><dt>@ClientText.T("项目编码")</dt><dd>@_project.Code</dd><dt>@ClientText.T("状态")</dt><dd>@(_project.Status=="active"?ClientText.T("正常"):ClientText.T("已归档"))</dd><dt>@ClientText.T("负责人")</dt><dd title="@_project.OwnerId">@Workspace.Assignee(_project.OwnerId)</dd><dt>@ClientText.T("项目成员")</dt><dd>@foreach(var id in _project.MemberUserIds) { <div title="@id">@Workspace.Assignee(id)</div> }</dd></dl><h2>@ClientText.T("BUG 状态分布")</h2><div class="stat-grid">@foreach(var s in BugDisplay.Statuses) { <div><span>@s.Value</span><strong>@_projectBugs.Count(b=>b.Status==s.Key)</strong></div> }</div><div class="actions"><button class="primary" @onclick="() => Host.OpenAsync(new(DesktopViewKind.Main,ProjectId:_project.Id), View)">@ClientText.T("打开 BUG 看板")</button><button @onclick="BatchPrompt">@ClientText.T("⧉ 复制批量修复提示词")</button>@if(CanManage(_project)) { <button @onclick="() => Host.OpenAsync(new(DesktopViewKind.ProjectEdit,_project.Id,_project.Id), View)">@ClientText.T("编辑项目")</button><button @onclick="() => Host.OpenAsync(new(DesktopViewKind.ProjectInvitations,_project.Id,_project.Id), View)">@ClientText.T("邀请成员")</button> }</div></div> }
break;
case DesktopViewKind.ProjectCreate:
case DesktopViewKind.ProjectEdit:
@if(View.Kind==DesktopViewKind.ProjectEdit && !CanManage(_project)) { <p>@ClientText.T("仅项目负责人可管理此项目。")</p> } else {
<div class="form"><label>@ClientText.T("项目名称")<input maxlength="100" @bind="_input.Name" /></label><label>@ClientText.T("项目编码（选填）")<input maxlength="50" placeholder="@ClientText.T("留空自动生成")" @bind="_input.Code" /></label><label>@ClientText.T("描述（选填）")<textarea rows="3" @bind="_input.Description"></textarea></label>@if(Workspace.Access.IsTenantAdmin) { <label>@ClientText.T("负责人")<AssigneeSelect @bind-Value="_input.OwnerId" /></label> } else { <p class="muted">@ClientText.T("你是项目负责人，可修改项目名称，并通过邀请链接添加成员。")</p> }@if(View.Kind==DesktopViewKind.ProjectEdit) { <label>@ClientText.T("状态")<select @bind="_input.Status"><option value="active">@ClientText.T("正常")</option><option value="archived">@ClientText.T("已归档")</option></select></label> }@if(Workspace.Access.IsTenantAdmin || View.Kind==DesktopViewKind.ProjectEdit) { <fieldset><legend>@ClientText.T("项目成员")</legend>@foreach(var user in Workspace.Users.Where(u=>Workspace.Access.IsTenantAdmin || _project?.MemberUserIds.Contains(u.Id)==true)) { <label class="check-row" title="@user.Id"><input type="checkbox" checked="@_members.Contains(user.Id)" disabled="@(user.Id == _project?.OwnerId)" @onchange="e=>Member(user.Id,e.Value is true)" />@Workspace.Assignee(user.Id)</label> }@foreach(var id in _members.Where(id=>!Workspace.Users.Any(u=>u.Id==id)).ToArray()) { <label class="check-row" title="@id"><input type="checkbox" checked @onchange="e=>Member(id,e.Value is true)" />@id</label> }</fieldset> }<div class="actions"><button @onclick="Close">@ClientText.T("取消")</button><button class="primary" disabled="@(_busy || !Host.CanWrite)" @onclick="SaveProject">@ClientText.T("保存项目")</button></div></div> }
break;
case DesktopViewKind.Keys:
<p class="notice">@ClientText.T("个人 AI 接入凭据。明文 Key 仅在创建成功后显示一次。")</p><table><thead><tr><th>@ClientText.T("名称")</th><th>@ClientText.T("Key 前缀")</th><th>@ClientText.T("权限范围")</th><th>@ClientText.T("状态")</th><th>@ClientText.T("创建时间")</th><th></th></tr></thead><tbody>@foreach(var key in _keys) { <tr><td>@key.Name</td><td><code>@key.KeyPrefix</code></td><td>@string.Join("、",key.Scopes)</td><td>@(key.Enabled?ClientText.T("启用"):ClientText.T("停用"))</td><td>@key.CreateTime.ToLocalTime().ToString("g", ClientText.Culture)</td><td><button class="danger" disabled="@(_busy || !Host.CanWrite)" @onclick="()=>Revoke(key)">@ClientText.T("撤销")</button></td></tr> }</tbody></table>@if(_keys.Count==0) { <p class="center">@ClientText.T("暂无 MCP Key")</p> }
break;
case DesktopViewKind.KeyCreate:
<div class="form"><label>@ClientText.T("名称")<input maxlength="100" @bind="_keyName" /></label><fieldset><legend>@ClientText.T("权限范围")</legend>@foreach(var scope in new[]{"bug:read","bug:write","bug:delete","bug:admin"}) { <label class="check-row"><input type="checkbox" checked="@_scopes.Contains(scope)" @onchange="e=>Scope(scope,e.Value is true)" />@scope</label> }</fieldset><div class="actions"><button @onclick="Close">@ClientText.T("取消")</button><button class="primary" disabled="@(_busy || !Host.CanWrite)" @onclick="CreateKey">@ClientText.T("创建")</button></div></div>
break;
case DesktopViewKind.KeyResult:
@if(_result is not null) { <div class="form"><p class="notice">@ClientText.T("请立即保存。关闭此窗口后无法再次查看明文 Key。")</p><label>@ClientText.T("名称")<input readonly value="@_result.Name" /></label><label>@ClientText.T("明文 Key")<textarea readonly rows="3" value="@_result.PlainKey"></textarea></label><div class="actions"><button @onclick="()=>Host.CopyAsync(_result.PlainKey)">@ClientText.T("⧉ 复制 Key")</button><button class="primary" @onclick="()=>Host.CopyAsync(_setupPrompt)">@ClientText.T("⧉ 复制 MCP 接入提示词")</button></div><pre class="setup-prompt">@_setupPrompt</pre><button @onclick="Close">@ClientText.T("我已保存，关闭")</button></div> } else { <p>@ClientText.T("此明文 Key 已消费，请查看原结果窗口。")</p> }
break;
case DesktopViewKind.Users:
@if(!Workspace.Access.IsTenantAdmin) { <p>@ClientText.T("仅租户管理员可访问用户目录。")</p> } else { <p class="notice">@ClientText.T("用户身份由 Heimdall 维护。")</p><table><thead><tr><th>@ClientText.T("显示名称")</th><th>@ClientText.T("用户名")</th><th>@ClientText.T("用户 ID")</th><th>@ClientText.T("状态")</th></tr></thead><tbody>@foreach(var user in Workspace.Users.Skip((_page-1)*20).Take(20)) { <tr><td>@user.DisplayName</td><td>@user.Username</td><td><code>@user.Id</code></td><td>@(user.Status==1?ClientText.T("启用"):ClientText.T("停用"))</td></tr> }</tbody></table><div class="pagination"><button disabled="@(_page<=1)" @onclick="()=>_page--">‹</button><span>@_page</span><button disabled="@(_page*20>=Workspace.Users.Count)" @onclick="()=>_page++">›</button></div> }
break;
case DesktopViewKind.Image:
@if(_image is not null) { <img class="attachment-preview" alt="@_image.FileName" src="@ImageSource" /> }
break;
}
</div></main>
