@inject IClientHost Host
@implements IDisposable

<main class="settings-shell">
    <aside class="settings-sidebar">
        <div class="settings-brand"><h1>@ClientText.T("设置")</h1><p>@ClientText.T("按你的习惯调整工作区")</p></div>
        <nav class="settings-navigation" aria-label="@ClientText.T("设置分类")">
            @foreach (var group in Groups) {
                <div class="settings-nav-group">
                    <div class="settings-nav-caption">@ClientText.T(group.Label)</div>
                    @foreach (var item in group.Items) {
                        <button type="button" class="settings-nav-item @(_section == item.Id ? "selected" : "")" aria-current="@(_section == item.Id ? "page" : null)" @onclick="() => SelectSection(item.Id)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@item.Icon" /></svg><span>@ClientText.T(item.Label)</span>
                        </button>
                    }
                </div>
            }
        </nav>
        <div class="settings-storage"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v11H4zM7 4h10M8 14h.01M11 14h6" /></svg>@ClientText.T("偏好保存在此设备")</div>
    </aside>
    <div class="settings-main">
        <div class="settings-content" @key="_section">
            @if (_section != "notifications") {
                <header class="settings-page-heading">
                    <p>@ClientText.T(Current.Category)</p><h2>@ClientText.T(Current.Label)</h2><div>@ClientText.T(Current.Description)</div>
                </header>
            }
            @if (_section == "general") {
                <div class="settings-general">
                    <div class="preference-row">
                        <div><label for="language-preference">@ClientText.T("语言")</label><p>@ClientText.T("立即应用到所有窗口，默认跟随操作系统。")</p></div>
                        <select @key="_resetVersion" id="language-preference" value="@Host.LanguagePreference" @onchange="ChangeLanguage"><option value="system">@ClientText.T("跟随系统")</option><option value="zh-CN">简体中文</option><option value="en">English</option></select>
                    </div>
                    <div class="preference-row">
                        <div><label for="close-behavior">@ClientText.T("关闭主窗口时")</label><p>@ClientText.T("选择退出程序或最小化到系统托盘。")</p></div>
                        <select @key="_resetVersion" id="close-behavior" value="@Host.CloseBehavior" @onchange="ChangeCloseBehavior"><option value="ask">@ClientText.T("继续询问")</option><option value="tray">@ClientText.T("最小化到托盘")</option><option value="exit">@ClientText.T("退出程序")</option></select>
                    </div>
                    <p class="settings-notice"><span aria-hidden="true">ⓘ</span>@ClientText.T("选“继续询问”，下次点击主窗口的关闭按钮时会重新提示。最小化到托盘后，后台同步和通知仍会继续；退出程序后则会停止。")</p>
                </div>
            } else if (_section == "appearance") {
                <fieldset class="settings-appearance" @key="_resetVersion">
                    <legend>@ClientText.T("主题")</legend><p>@ClientText.T("可随系统自动切换，也可以固定使用一种模式。")</p>
                    <div class="settings-theme-options">
                        @foreach (var choice in Themes) {
                            <label class="settings-theme-option @(Host.ThemePreference == choice.Id ? "selected" : "")">
                                <input type="radio" name="theme-preference" value="@choice.Id" checked="@(Host.ThemePreference == choice.Id)" @onchange="() => ChangeTheme(choice.Id)" />
                                <span class="settings-theme-preview @choice.Id" aria-hidden="true"><span class="settings-theme-bar"></span><span class="settings-theme-screen"><span></span><i></i></span></span>
                                <span class="settings-theme-label">@ClientText.T(choice.Label)<span aria-hidden="true">@(Host.ThemePreference == choice.Id ? "✓" : "")</span></span>
                            </label>
                        }
                    </div>
                    <small>@ClientText.T("主题偏好保存在此设备，可随时更改。")</small>
                </fieldset>
            } else if (_section == "lanes") {
                <LanePreferences Embedded="true" />
            } else if (_section == "notifications") {
                <NotificationPreferences Embedded="true" FeedbackChanged="OnNotificationFeedback" />
            } else {
                <div class="settings-update">
                    <div class="settings-update-app"><span class="settings-update-icon" aria-hidden="true">↻</span><div><strong>Asgard Brigitte</strong><small>@ClientText.T("当前版本：{0}", Host.AppVersion)</small></div></div>
                    <div class="settings-update-status"><div><strong>@ClientText.T("更新状态")</strong><p role="status">@Host.UpdateMessage</p></div><div class="settings-update-actions">
                        @if (Host.SupportsStoreUpdates) {
                            <button class="primary" disabled="@Host.UpdateBusy" @onclick="Host.CheckForUpdatesAsync">@ClientText.T("检查更新")</button>
                            @if (Host.UpdateAvailable) { <button disabled="@Host.UpdateBusy" @onclick="Host.InstallUpdateAsync">@ClientText.T("立即更新")</button> }
                        }
                    </div></div>
                    <p class="settings-notice"><span aria-hidden="true">ⓘ</span>@ClientText.T(Host.SupportsStoreUpdates ? "商店安装版本可在此检查更新；其他安装版本请从原下载渠道获取新版。" : "此安装版本不支持商店内更新，请从原下载渠道获取新版。")</p>
                </div>
            }
        </div>
        <footer class="settings-footer"><div aria-live="polite">@if (_error.Length > 0) { <span class="error" role="alert">@ClientText.T(_error)</span> } else { <span class="settings-saved"><span aria-hidden="true">✓</span> @ClientText.T(_message)</span> }</div><button @onclick="() => Host.Close(new(DesktopViewKind.Settings))">@ClientText.T("完成")</button></footer>
    </div>
</main>

@code {
    private sealed record SettingsItem(string Id, string Label, string Category, string Description, string Icon);
    private sealed record SettingsGroup(string Label, SettingsItem[] Items);
    private static readonly SettingsGroup[] Groups = [
        new("设备", [
            new("general", "常规", "设备偏好", "语言和窗口行为，按你的习惯设置。", "M4 7h16M4 12h16M4 17h16"),
            new("appearance", "外观", "设备偏好", "选择适合你的界面主题，所有窗口即时生效。", "M12 3a9 9 0 1 0 0 18 2 2 0 0 0 2-2c0-.5-.2-1-.5-1.4-.4-.5 0-1.3.7-1.3H17a4 4 0 0 0 4-4A9 9 0 0 0 12 3ZM7.5 11h.01M10 7.5h.01M15 7.5h.01")]),
        new("工作区", [
            new("lanes", "看板泳道", "工作区偏好", "为每个项目整理看板泳道的显示顺序。", "M4 4h16v16H4zM9 4v16M15 4v16"),
            new("notifications", "提醒", "工作区偏好", "管理此设备上当前账号的弹窗和系统通知。", "M6 17h12l-1.5-2V10a4.5 4.5 0 1 0-9 0v5L6 17ZM10 20h4")]),
        new("应用", [new("updates", "应用更新", "应用", "查看当前版本并检查可用更新。", "M20 7v5h-5M4 17v-5h5M5.5 9a7 7 0 0 1 12-2L20 12M4 12l2.5 5a7 7 0 0 0 12-2")])
    ];
    private static readonly (string Id, string Label)[] Themes = [("system", "跟随系统"), ("light", "白天"), ("dark", "晚间")];
    private string _section = "general", _error = "", _message = "修改后自动保存。";
    private int _resetVersion;
    private SettingsItem Current => Groups.SelectMany(group => group.Items).First(item => item.Id == _section);
    protected override void OnInitialized() { Host.StatusChanged += Refresh; Host.Changed += Refresh; }
    private void SelectSection(string section) { _section = section; _error = ""; _message = "修改后自动保存。"; }
    private void OnNotificationFeedback(string error, string message) { _error = error; _message = message; }
    private void ChangeCloseBehavior(ChangeEventArgs e) => Save(() => Host.SetCloseBehavior(e.Value?.ToString() ?? "ask"));
    private void ChangeTheme(string theme) => Save(() => Host.SetTheme(theme));
    private void ChangeLanguage(ChangeEventArgs e) => Save(() => Host.SetLanguage(e.Value?.ToString() ?? "system"));
    /// <summary>保存失败时显示错误，选择器重新显示实际已保存的值。</summary>
    private void Save(Action update)
    {
        try { update(); _error = ""; _message = "已保存。"; }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException or Microsoft.Data.Sqlite.SqliteException)
        { _resetVersion++; _error = "设置暂时无法保存，请检查设备的存储空间和文件权限后重试。"; }
    }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Host.StatusChanged -= Refresh; Host.Changed -= Refresh; }
}
